# Open Creation World (神笔马良 · 画板伙伴版) — 环境变量配置模板
# 复制本文件为 server/.env（所有配置项均可选；未配置密钥时自动进入确定性 Demo 演示模式）

# 视觉/对话大模型（OpenAI 兼容接口，如阿里百炼 DashScope qwen-vl-max 或火山引擎 Ark）
MODEL_ID=qwen-vl-max
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=

# 语音合成 (qwen-tts) 与语音识别 (qwen3-asr-flash) 密钥（留空则回落或静默降级）
VOICE_API_KEY=

# 可选：Meta AnimatedDrawings 服务地址
ANIMATED_DRAWINGS_URL=

# 服务端监听端口（默认 3402）
PORT=3402
