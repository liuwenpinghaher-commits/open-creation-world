# 神笔马良 v4 素质成长版 (Next.js 14) — 环境变量配置模板
# 复制本文件为 .env.local（未设置 MODEL_API_KEY / VOICE_API_KEY 时自动启用确定性 Demo 模式）

# 多模态对话模型配置（OpenAI 兼容接口，推荐 qwen-vl-max / 豆包视觉模型）
MODEL_API_KEY=
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_ID=qwen-vl-max

# 语音合成 (TTS) 与语音识别 (STT) 配置（留空则回落 MODEL_API_KEY 或内置静音/演示模式）
VOICE_API_KEY=
VOICE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
STT_MODEL=qwen3-asr-flash
TTS_MODEL=qwen-tts
TTS_VOICE=Cherry

# 可选：Picovoice Porcupine 离线唤醒词 AccessKey（未配置时自动回落浏览器语音模糊唤醒）
NEXT_PUBLIC_PORCUPINE_ACCESS_KEY=
